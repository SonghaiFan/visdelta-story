{
  "name": "visdelta-story",
  "version": "0.1.0",
  "private": true,
  "description": "An independent MDX scrollytelling studio built on the public VisDelta API.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "dev": "next dev --port 4322",
    "prebuild": "node scripts/prepare.mjs && npm run boundary:check",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node scripts/serve-out.mjs 4322",
    "lint": "eslint",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "boundary:check": "node scripts/check-boundary.mjs",
    "analyze:weather": "python3 scripts/analysis/weather-story.py",
    "test": "playwright test",
    "check": "npm run lint && npm run types:check && npm run build && npm test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@mdx-js/mdx": "3.1.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.1",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "visdelta": "file:vendor/visdelta-0.4.2.tgz",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
